// POS MODULE

model POSSession {
  id            String @id @default(cuid())
  sessionNumber String @unique

  cashierId String

  startTime DateTime         @default(now())
  endTime   DateTime?
  status    POSSessionStatus @default(OPEN)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  // Department tag association (optional). Allows POS sessions to be tagged
  // to a department for reporting/budgeting, alongside the warehouse attachment.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  openingCash Decimal  @default(0)
  closingCash Decimal? // Calculated system total
  actualCash  Decimal? // Counted by cashier
  difference  Decimal?

  notes String?

  salesOrders   SalesOrder[]
  salesInvoices SalesInvoice[]
  salesPayments SalesPayment[]
  heldOrders    HeldOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum POSSessionStatus {
  OPEN
  CLOSED
}

model HeldOrder {
  id        String   @id @default(cuid())
  holdId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  customerId   String?
  customer     Contact? @relation(fields: [customerId], references: [id])
  customerName String?

  items       Json
  totalAmount Decimal

  note String?

  posSessionId String?
  posSession   POSSession? @relation(fields: [posSessionId], references: [id])
}
