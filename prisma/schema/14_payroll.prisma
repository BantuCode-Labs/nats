// PAYROLL MODULE

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum PayrollPeriodStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

enum SalarySlipStatus {
  DRAFT
  PUBLISHED
  PAID
  CANCELLED
}

enum StatutoryRuleType {
  PPH21
  BPJS_KESEHATAN
  BPJS_TK_JHT
  BPJS_TK_JP
  BPJS_TK_JKK
  BPJS_TK_JKM
  CUSTOM
}

model PayrollPeriod {
  id        String              @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    PayrollPeriodStatus @default(DRAFT)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  payrollRuns PayrollRun[]
  salarySlips SalarySlip[]
}

model SalaryComponent {
  id          String              @id @default(cuid())
  name        String
  type        SalaryComponentType
  isTaxable   Boolean             @default(true)
  description String?
  isActive    Boolean             @default(true)
  /// Optional GL account for this component (liability for deductions, expense for earnings)
  accountId   String?
  account     Account?            @relation("SalaryComponentAccount", fields: [accountId], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  structureItems SalaryStructureItem[]
  slipItems      SalarySlipItem[]
}

model SalaryStructure {
  id         String   @id @default(cuid())
  name       String
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id])
  isActive   Boolean  @default(true)
  baseSalary Decimal  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items SalaryStructureItem[]

  createdById String?
}

model SalaryStructureItem {
  id          String          @id @default(cuid())
  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id])
  componentId String
  component   SalaryComponent @relation(fields: [componentId], references: [id])
  amount      Decimal         @default(0) // Fixed amount or base for formula
  formula     String? // Optional: formula for calculation (supports BASE, GROSS, variables)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PayrollRun {
  id              String              @id @default(cuid())
  periodId        String
  period          PayrollPeriod       @relation(fields: [periodId], references: [id])
  runDate         DateTime            @default(now())
  totalEarnings   Decimal             @default(0)
  totalDeductions Decimal             @default(0)
  netPay          Decimal             @default(0)
  status          PayrollPeriodStatus @default(PROCESSING)

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalarySlip {
  id              String           @id @default(cuid())
  periodId        String
  period          PayrollPeriod    @relation(fields: [periodId], references: [id])
  contactId       String
  contact         Contact          @relation(fields: [contactId], references: [id])
  grossSalary     Decimal          @default(0)
  totalDeductions Decimal          @default(0)
  netSalary       Decimal          @default(0)
  status          SalarySlipStatus @default(DRAFT)
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items SalarySlipItem[]
}

model SalarySlipItem {
  id          String              @id @default(cuid())
  slipId      String
  slip        SalarySlip          @relation(fields: [slipId], references: [id], onDelete: Cascade)
  componentId String
  component   SalaryComponent     @relation(fields: [componentId], references: [id])
  amount      Decimal
  type        SalaryComponentType
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

/// Configurable statutory payroll rules (PPh 21, BPJS, etc.)
model StatutoryRule {
  id          String             @id @default(cuid())
  name        String
  type        StatutoryRuleType
  isActive    Boolean            @default(true)
  /// JSON config: rates, caps, employer/employee share, PTKP amounts, etc.
  config      Json
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([type, isActive])
}
